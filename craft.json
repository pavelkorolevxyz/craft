{
  "name": "Craft",
  "version": "0.1.0",
  "language": "ru",
  "surfaces": {
    "interface": {
      "templates": [
        "report",
        "dashboard",
        "tool",
        "design-system"
      ],
      "entrypoints": [
        "assets/interfaces/starter-index.html",
        "assets/interfaces/dashboard-index.html",
        "assets/interfaces/tool-index.html",
        "assets/interfaces/specimen.html"
      ]
    },
    "slides": {
      "templates": [
        "deck"
      ],
      "layouts": [
        "cover",
        "context",
        "section",
        "statement",
        "list",
        "comparison",
        "quote",
        "metrics",
        "code",
        "figure",
        "screenshot",
        "table",
        "steps",
        "chart",
        "timeline",
        "flow",
        "visual-comparison",
        "title",
        "resource",
        "end"
      ],
      "entrypoints": [
        "assets/slides/starter/index.html",
        "assets/slides/specimen.html"
      ]
    }
  },
  "dynamicCssProperties": [
    "--at",
    "--column-ratio",
    "--columns",
    "--metrics",
    "--space",
    "--stack-gap",
    "--swatch",
    "--value"
  ],
  "requirements": {
    "fontFiles": 4,
    "offline": true,
    "buildRequired": false
  }
}
