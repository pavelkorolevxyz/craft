{
  "name": "Craft",
  "version": "0.2.0",
  "language": "ru",
  "surfaces": {
    "interface": {
      "templates": [
        "blank"
      ],
      "entrypoints": [
        "assets/interfaces/starter-index.html"
      ],
      "fragments": [
        "assets/interfaces/fragments/page-head.html",
        "assets/interfaces/fragments/workspace-head.html",
        "assets/interfaces/fragments/metric-strip.html",
        "assets/interfaces/fragments/section.html",
        "assets/interfaces/fragments/split-workspace.html",
        "assets/interfaces/fragments/data-table.html",
        "assets/interfaces/fragments/empty-state.html",
        "assets/interfaces/fragments/section-nav.html"
      ]
    },
    "slides": {
      "templates": [
        "deck"
      ],
      "entrypoints": [
        "assets/slides/starter/index.html"
      ],
      "layouts": [
        "title",
        "section",
        "statement",
        "list",
        "comparison",
        "figure",
        "chart",
        "table",
        "code",
        "flow",
        "end"
      ],
      "fragments": [
        "assets/slides/fragments/title.html",
        "assets/slides/fragments/section.html",
        "assets/slides/fragments/statement.html",
        "assets/slides/fragments/list.html",
        "assets/slides/fragments/split.html",
        "assets/slides/fragments/figure.html",
        "assets/slides/fragments/chart.html",
        "assets/slides/fragments/table.html",
        "assets/slides/fragments/code.html",
        "assets/slides/fragments/flow.html",
        "assets/slides/fragments/end.html"
      ]
    }
  },
  "dynamicCssProperties": [
    "--at",
    "--column-ratio",
    "--columns",
    "--metrics",
    "--space",
    "--stack-gap",
    "--swatch",
    "--value"
  ],
  "requirements": {
    "fontFiles": 4,
    "offline": true,
    "buildRequired": false
  }
}
